        "name": "query_next",
        "module": "dbupdater",
        "action": "custom",
        "options": {
          "connection": "db",
          "sql": {
            "query": "with p as (\n  select id from user_path\n  where user_id = :P1::int and is_active\n  order by id desc limit 1\n), s as (\n  select ups.position, ups.activity_id, ups.reason,\n         coalesce(ap.status, 'pending') as status,\n         coalesce(ap.attempts, 0) as attempts\n  from user_path_step ups\n  join p on p.id = ups.user_path_id\n  left join activity_progress ap on ap.user_id = :P1::int and ap.activity_id = ups.activity_id\n)\nselect p.id as user_path_id,\n       (select count(*) from s where s.status = 'done')::int as done,\n       (select count(*) from s)::int as total,\n       n.activity_id is null as finished,\n       n.position, n.activity_id, a.title, a.kind, a.level_n,\n       sk.code as skill_code, sk.title as skill_title,\n       a.content, a.explanation, a.examshell_id,\n       n.status, n.attempts, n.reason\nfrom p\nleft join lateral (\n  select * from s where s.status <> 'done' order by s.position limit 1\n) n on true\nleft join activity a on a.id = n.activity_id\nleft join skill sk on sk.id = a.skill_id",
            "params": [
              {
                "name": ":P1",
                "value": "{{security_db.identity}}",
                "test": ""
              }
            ]
          }
        },
        "output": false,
