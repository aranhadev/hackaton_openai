      {
        "name": "",
        "module": "core",
        "action": "trycatch",
        "options": {
          "try": {
            "steps": [
              {
                "name": "api_explain",
                "module": "api",
                "action": "send",
                "options": {
                  "url": "https://api.openai.com/v1/chat/completions",
                  "method": "POST",
                  "dataType": "json",
                  "throwErrors": true,
                  "passErrors": false,
                  "timeout": 20000,
                  "data": {
                    "model": "{{$_ENV.OPENAI_MODEL}}",
                    "temperature": 0.3,
                    "messages": [
                      {
                        "role": "system",
                        "content": "Você é tutor de linguagem C e fala com o estudante em português, na segunda pessoa (\"você\"), em tom encorajador. Use só os dados enviados; não invente notas, questões nem atividades. A trilha já foi montada pelo sistema: explique, não altere.\nRegras:\n- Cada campo de texto tem no máximo 25 palavras.\n- Não use \"zero\", \"ruim\", \"fraco\" nem números decimais; fale em porcentagem ou em \"x de y\" quando precisar citar resultado.\n- Em cada confusão, explique só o erro da alternativa que o estudante escolheu, comparando com a resposta correta. Não cite outros erros possíveis da mesma questão.\nCampos:\n- resumo: 1 frase sobre o resultado geral, começando pelo que ele já domina.\n- confusoes: uma entrada por erro (lista vazia se não errou nada); confusao = a ideia errada, em linguagem simples; explicacao = por que a resposta correta é a correta.\n- por_que_comeca_aqui: 1 frase ligando o menor resultado à primeira atividade.\n- primeiro_foco: o que ele vai praticar na primeira atividade, com base no enunciado dela.\n- dica: 1 ação prática para estudar."
                      },
                      {
                        "role": "user",
                        "content": "Resultado por habilidade: {{query_scores.toJSON()}}. Erros (alternativa escolhida, resposta correta e a confusão que revela): {{query_mistakes.toJSON()}}. Trilha montada: {{query_plan.toJSON()}}. Primeira atividade: {{query_first_step[0].toJSON()}}."
                      }
                    ],
                    "response_format": {
                      "type": "json_schema",
                      "json_schema": {
                        "name": "diagnostic_feedback",
                        "strict": true,
                        "schema": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "resumo",
                            "confusoes",
                            "por_que_comeca_aqui",
                            "primeiro_foco",
                            "dica"
                          ],
                          "properties": {
                            "resumo": {
                              "type": "string"
                            },
                            "confusoes": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "skill_code",
                                  "confusao",
                                  "explicacao"
                                ],
                                "properties": {
                                  "skill_code": {
                                    "type": "string",
                                    "enum": [
                                      "ponteiros",
                                      "memoria",
                                      "algoritmos"
                                    ]
                                  },
                                  "confusao": {
                                    "type": "string"
                                  },
                                  "explicacao": {
                                    "type": "string"
                                  }
                                }
                              }
                            },
                            "por_que_comeca_aqui": {
                              "type": "string"
                            },
                            "primeiro_foco": {
                              "type": "string"
                            },
                            "dica": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  },
                  "headers": {
                    "Authorization": "Bearer {{$_ENV.OPENAI_API_KEY}}"
                  }
                },
                "output": false
              },
              {
                "name": "",
                "module": "core",
                "action": "condition",
                "options": {
                  "if": "{{api_explain.data.choices[0].finish_reason != 'stop' || api_explain.data.choices[0].message.refusal}}",
                  "then": {
                    "steps": [
                      {
                        "name": "",
                        "module": "core",
                        "action": "error",
                        "options": {
                          "message": "Resposta da IA incompleta ou recusada"
                        }
                      }
                    ]
                  }
                },
                "outputType": "boolean"
              },
              {
                "name": "explanation",
                "module": "core",
                "action": "setvalue",
                "options": {
                  "value": "{{api_explain.data.choices[0].message.content.parseJSON()}}"
                },
                "meta": [],
                "outputType": "object",
                "output": true
              },
              {
                "name": "explanation_source",
                "module": "core",
                "action": "setvalue",
                "options": {
                  "value": "openai"
                },
                "meta": [],
                "outputType": "text",
                "output": true
              }
            ]
          },
          "catch": {
            "steps": [
              {
                "name": "query_fallback",
                "module": "dbupdater",
                "action": "custom",
                "options": {
                  "connection": "db",
                  "sql": {
                    "query": "with first_step as (\n  select skill_code, activity_title, reason\n  from attempt_path_plan\n  where attempt_id = :P1\n  order by position\n  limit 1\n)\nselect jsonb_build_object(\n  'resumo', 'Sua trilha começa por ' || f.skill_code\n            || ', a habilidade em que você teve o menor acerto no diagnóstico.',\n  'confusoes', coalesce((\n    select jsonb_agg(jsonb_build_object(\n             'skill_code', s.code,\n             'confusao', o.feedback,\n             'explicacao', 'Você escolheu \"' || o.text || '\" em: ' || q.statement\n           ) order by q.id)\n    from diagnostic_answer da\n    join question q on q.id = da.question_id\n    join skill s on s.id = q.skill_id\n    join question_option o on o.id = da.option_id\n    where da.attempt_id = :P1 and not da.is_correct and o.feedback is not null\n  ), '[]'::jsonb),\n  'por_que_comeca_aqui', f.reason,\n  'primeiro_foco', f.activity_title,\n  'dica', 'Faça as atividades na ordem: cada uma usa o que a anterior treinou.'\n) as feedback\nfrom first_step f",
                    "params": [
                      {
                        "name": ":P1",
                        "value": "{{$_POST.attempt_id}}",
                        "test": ""
                      }
                    ]
                  }
                },
                "output": false,
                "meta": [
                  {
                    "name": "feedback",
                    "type": "object"
                  }
                ],
                "outputType": "array",
                "type": "dbcustom_query"
              },
              {
                "name": "explanation",
                "module": "core",
                "action": "setvalue",
                "options": {
                  "value": "{{query_fallback[0].feedback}}"
                },
                "meta": [],
                "outputType": "object",
                "output": true
              },
              {
                "name": "explanation_source",
                "module": "core",
                "action": "setvalue",
                "options": {
                  "value": "fallback"
                },
                "meta": [],
                "outputType": "text",
                "output": true
              }
            ]
          }
        }
      },
